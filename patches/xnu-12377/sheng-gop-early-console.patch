+/*
+ * sheng: the port ships no Apple display driver, so take the linear GOP
+ * framebuffer the firmware already painted and hand it to the XNU video
+ * console.  Without this the first kprintf lands in
+ * AppleM2ScalerCSCDriver with an unstarted provider and panics.
+ */
+static void
+sheng_gop_console(void)
+{
+	static PE_Video video;
+	uint64_t base = 0, stride = 0, width = 0, height = 0, depth = 0;
+
+	if (!PE_parse_boot_argn("gop-base", &base, sizeof(base)) || base == 0) {
+		initialize_screen(NULL, kPEAcquireScreen);
+		return;
+	}
+	PE_parse_boot_argn("gop-stride", &stride, sizeof(stride));
+	PE_parse_boot_argn("gop-width", &width, sizeof(width));
+	PE_parse_boot_argn("gop-height", &height, sizeof(height));
+	PE_parse_boot_argn("gop-depth", &depth, sizeof(depth));
+	if (stride == 0 || width == 0 || height == 0) {
+		initialize_screen(NULL, kPEAcquireScreen);
+		return;
+	}
+	if (depth == 0) {
+		depth = 32;
+	}
+	bzero(&video, sizeof(video));
+	video.v_baseAddr = (unsigned long)(base | 1);       /* low bit: physical address */
+	video.v_rowBytes = (unsigned long)stride;
+	video.v_width    = (unsigned long)width;
+	video.v_height   = (unsigned long)height;
+	video.v_depth    = (unsigned long)depth;
+	video.v_length   = (unsigned long)(stride * height);
+	video.v_scale    = kPEScaleFactor2x;
+	PE_state.video = video;
+	PE_initialize_console(&video, kPEAcquireScreen);
+	kprintf("sheng: gop console %llux%llu stride %llu at %llx\n",
+	    width, height, stride, base);
+}
+
