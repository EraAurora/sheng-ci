+/*
+ * sheng: draw every glyph pixel as a scale x scale block so the console text
+ * grows with vc_uiscale (the panic screen is unreadable at 8x16 on a 12.4"
+ * panel). Only the 32-bit path is used on this framebuffer.
+ */
 static void
+vc_paint_char_32_scaled(unsigned int xx, unsigned int yy, unsigned char ch, int attrs)
+{
+	uint32_t *theChar;
+	unsigned int sx = vc_cell_width / ISO_CHAR_WIDTH;
+	unsigned int sy = vc_cell_height / ISO_CHAR_HEIGHT;
+	uint32_t *origin;
+	unsigned int i, r, x, c;
+
+	if (vc_rendered_font) {
+		theChar = (uint32_t *)(vc_rendered_font + (ch * vc_rendered_char_size));
+	} else {
+		vc_render_char(ch, vc_rendered_char, 32);
+		theChar = (uint32_t *)(vc_rendered_char);
+	}
+	origin = (uint32_t *)(vinfo.v_baseaddr +
+	    (yy * vc_cell_height * vinfo.v_rowbytes) +
+	    (xx * vc_cell_width * 4));
+
+	for (i = 0; i < ISO_CHAR_HEIGHT; i++) {
+		uint32_t *src = theChar + i * ISO_CHAR_WIDTH;
+		for (r = 0; r < sy; r++) {
+			uint32_t *store = (uint32_t *)((unsigned char *)origin +
+			    (i * sy + r) * vinfo.v_rowbytes);
+			for (x = 0; x < ISO_CHAR_WIDTH; x++) {
+				uint32_t val = *src++;
+				if (attrs & ATTR_REVERSE) {
+					val = ~val;
+				}
+				val = (vc_color_back & ~val) | (vc_color_fore & val);
+				for (c = 0; c < sx; c++) {
+					*store++ = val;
+				}
+			}
+		}
+	}
+}
